# Keep engagement inputs and outputs in a private workspace.
# These paths are conveniences, not an access-control mechanism.
/client_data/
/private/
/outputs/

# Local credentials and environment files
.env
.env.*
!.env.example
.venv/
venv/

# Python and notebook working files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Temporary office and operating-system files
~$*
*.tmp
.DS_Store
Thumbs.db
